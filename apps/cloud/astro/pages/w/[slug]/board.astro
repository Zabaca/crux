---
/**
 * `/w/<slug>/board` — the roadmap board, where Stage is edited by dragging.
 *
 * `/w/<slug>` remains the read view of the same Problems. This is the write
 * surface, and it is an Astro route because it is the one page that needs a
 * hydrated island (ADR-0004): the lanes are server-rendered from `query()` and
 * @dnd-kit takes over in the browser.
 */
import { env } from "cloudflare:workers";
import { query } from "@crux/core/reads";
import type { ProblemSummary, WorkstreamRow } from "@crux/core/reads";

import ActionBar from "../../../components/ActionBar.tsx";
import RoadmapBoard from "../../../components/RoadmapBoard.tsx";
import type { BoardProblem, Stage } from "../../../components/RoadmapBoard.tsx";
import { html } from "../../../../src/web/html.js";
import { page } from "../../../../src/web/layout.js";
import { workstreamActions } from "../../../lib/page-actions.js";
import { pageContext } from "../../../../src/web/session.js";

const ctx = await pageContext(env, Astro.request);
if (!ctx.ok) return ctx.response;

const slug = Astro.params.slug!;
const ws = (await query({ kind: "WORKSTREAM_BY_SLUG", slug }, { db: ctx.db })) as WorkstreamRow | null;
if (!ws) return new Response(null, { status: 404 });

const summaries = (await query(
  { kind: "PROBLEM_SUMMARIES", workstreamId: ws.id },
  { db: ctx.db },
)) as ProblemSummary[];

// `done` and `abandoned` are terminal — they are not lanes you drag into, so
// the board shows the four schedulable Stages and the read page shows the rest.
const DRAGGABLE = new Set(["now", "next", "later", null]);
const problems: BoardProblem[] = summaries
  .filter((p) => DRAGGABLE.has(p.status))
  .map((p) => ({
    id: p.id,
    title: p.title,
    stage: (p.status ?? "unscheduled") as Stage,
    evidenceCount: p.evidenceCount,
    solutionCount: p.solutionCount,
    decided: p.decided,
  }));

const shell = page({
  title: `${ws.title} · Board`,
  viewer: ctx.viewer,
  workspace: ctx.workspace,
  body: html`<!--BOARD-->`,
}).value;
const [head, tail] = shell.split("<!--BOARD-->");
---
<Fragment set:html={`<!doctype html>\n${head}`} />
<div class="crumb"><a href="/">Workstreams</a> / <a href={`/w/${slug}`}>{ws.slug}</a> / board</div>
<h1>{ws.title}</h1>
<p class="sub">Drag a Problem between Stages. Every move is a transition — the server can refuse one.</p>
<ActionBar client:load actions={workstreamActions(slug)} />
<RoadmapBoard client:load slug={slug} problems={problems} />
<Fragment set:html={tail} />
