---
/**
 * `/w/<slug>` — the Workstream: its Problems laid out by Stage, and the place
 * Stage is edited.
 *
 * There used to be two of these — a read page rendered by `read-pages.ts` and a
 * board at `/w/<slug>/board` — and the split was a rendering seam (only Astro
 * can hydrate an island, ADR-0009) that had leaked into the URL space. It read
 * badly in both directions: the board was a strict subset of the read page's
 * lanes with less on each card, and the read page could show you where a
 * Problem stood but not move it. One page, six lanes, drag where dragging is
 * legal.
 */
import { env } from "cloudflare:workers";

import ActionBar from "../../../components/ActionBar.tsx";
import RoadmapBoard from "../../../components/RoadmapBoard.tsx";
import type { BoardProblem, Stage } from "../../../components/RoadmapBoard.tsx";
import { boardData } from "../../../../src/web/board.js";
import { html } from "../../../../src/web/html.js";
import { page } from "../../../../src/web/layout.js";
import { workstreamActions } from "../../../lib/page-actions.js";
import { pageContext } from "../../../../src/web/session.js";

const ctx = await pageContext(env, Astro.request);
if (!ctx.ok) return ctx.response;

const slug = Astro.params.slug!;
const data = await boardData(ctx.read, slug);
if (!data) return new Response(null, { status: 404 });
const { workstream: ws, problems: summaries, observations } = data;

// `null` is *unscheduled* — filed, not yet on the roadmap. Every other status
// is a lane name already, which is why the board takes the whole list.
const problems: BoardProblem[] = summaries.map((p) => ({
  id: p.id,
  title: p.title,
  stage: (p.status ?? "unscheduled") as Stage,
  evidenceCount: p.evidenceCount,
  attemptCount: p.attemptCount,
  openAttemptCount: p.openAttemptCount,
}));
const open = summaries.filter((p) => p.status !== "done" && p.status !== "abandoned").length;

// The Observations are not on this page — they are a different pile with a
// different rhythm, and there can be an order of magnitude more of them. What
// belongs here is the one number that says whether the pile needs a pass:
// filed, and neither linked to a Problem nor archived.
const waiting = observations.filter((o) => !o.archive && o.problemCount === 0).length;

const shell = page({
  title: ws.title,
  viewer: ctx.viewer,
  workspace: ctx.workspace,
  body: html`<!--BOARD-->`,
}).value;
const [head, tail] = shell.split("<!--BOARD-->");
---
<Fragment set:html={`<!doctype html>\n${head}`} />
<div class="crumb"><a href="/">Workstreams</a> / {ws.slug}</div>
<h1>{ws.title}</h1>
<p class="sub">
  {open} open {open === 1 ? "Problem" : "Problems"} · {summaries.length} total ·
  <a href={`/w/${slug}/observations`}>{observations.length} Observations</a>{waiting > 0 ? `, ${waiting} waiting` : ""}.
  {ws.description ?? ""}
</p>
<ActionBar client:load actions={workstreamActions(slug)} />
<RoadmapBoard client:load slug={slug} workstreamId={ws.id} problems={problems} />
<p class="legend">
  Stage is a Problem’s place on the roadmap. A Problem starts <b>unscheduled</b>; scheduling
  places it in <b>now</b>, <b>next</b> or <b>later</b>; it ends <b>done</b> or <b>abandoned</b>.
  Drag a card between the first four — every move is a transition, and the server can refuse one.
  The last two are reached by an Outcome or an Abandonment, not by dragging. The bar on each card
  is what is behind it and what is in flight: Evidence → Attempts → an Attempt still open.
</p>
<Fragment set:html={tail} />
