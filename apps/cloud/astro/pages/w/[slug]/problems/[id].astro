---
/**
 * `/w/<slug>/problems/<id>` — the Problem, unchanged, plus the actions that
 * narrow it.
 *
 * The view itself is still `problemPage()` from `src/web/read-pages.ts`: moving
 * this URL onto Astro is a routing change, not a rewrite. What Astro adds is the
 * one thing the hand-written entry cannot do — hydrate an island next to the
 * server-rendered page: the action bar, and the subscription that re-reads the
 * page when this Workstream changes under it.
 */
import { env } from "cloudflare:workers";

import ActionBar from "../../../../components/ActionBar.tsx";
import LiveRefresh from "../../../../components/LiveRefresh.tsx";
import { problemActions } from "../../../../lib/page-actions.js";
import { html } from "../../../../../src/web/html.js";
import { page } from "../../../../../src/web/layout.js";
import { PageNotFound, problemPage } from "../../../../../src/web/read-pages.js";
import { pageContext } from "../../../../../src/web/session.js";

const ctx = await pageContext(env, Astro.request);
if (!ctx.ok) return ctx.response;

const slug = Astro.params.slug!;
const id = Astro.params.id!;

let rendered;
try {
  // The islands need the Problem the view just rendered — its open Attempts for
  // the action bar, its Workstream for the subscription. `problemPage` hands
  // back the detail it read rather than making the page ask for it a second
  // time, which was a whole `PROBLEM_DETAIL` read for an answer already in hand.
  rendered = await problemPage(ctx.read, slug, id);
} catch (err) {
  if (!(err instanceof PageNotFound)) throw err;
  return new Response(null, { status: 404 });
}
const detail = rendered.detail;

const actions = problemActions(
  detail.problem.id,
  detail.attempts.filter((a) => a.status === "open").map((a) => ({ id: a.id, label: a.label })),
);

const shell = page({
  title: rendered.title,
  viewer: ctx.viewer,
  workspace: ctx.workspace,
  body: html`${rendered.body}<!--ACTIONS-->`,
}).value;
const [head, tail] = shell.split("<!--ACTIONS-->");
---
<Fragment set:html={`<!doctype html>\n${head}`} />
<ActionBar client:load actions={actions} />
<LiveRefresh client:load workstreamId={detail.problem.workstreamId} />
<Fragment set:html={tail} />
