{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    // Islands run in a browser, not in workerd: the DOM lib is the point of a
    // separate project. `cloudflare:workers` is imported only by `.astro`
    // frontmatter, which tsc does not read.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // `bun` is here for the island tests under `lib/__tests__`, which run on
    // the bun runner alongside the rest of `bun run test`.
    "types": ["react", "react-dom", "bun"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
