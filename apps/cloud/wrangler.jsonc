{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloud crux: one Worker holding the site and the JSON API together
  // (ADR-0004). Today it serves only a stub /health route — the Astro shell
  // (CRUX-6D86GE) and the API over dispatch() (CRUX-1Z93XN) land here later.
  //
  // Deployed through zbc, not by hand: packages/infra/environments/production/
  // cloud.ts is the instance, and `zbc apply production` runs wrangler for you.
  // This file stays the source of truth for the Worker's topology.
  "name": "crux-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  // Better Auth hashes passwords with scrypt from `node:crypto` on the workerd
  // export condition, so the browser sessions do not work without this.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Per-user view-state lives in a Durable Object — off the filesystem. It
  // survives Astro's bundle because astro.config.mjs names it in
  // `workerEntryPoint.namedExports`.
  "durable_objects": {
    "bindings": [{ "name": "VIEW_STATE", "class_name": "ViewStateDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ViewStateDO"] }],
  // D1 has no zbc module, so the database is created once by hand
  // (`wrangler d1 create crux-production`) and bound here by id — the shape
  // ADR-0004 settled on. Its schema is end-state DDL applied by
  // `applyD1Schema` (ADR-0006).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crux-production",
      "database_id": "18dc8b49-7e2a-418b-aceb-5720dd3b9373"
    }
  ]
}
