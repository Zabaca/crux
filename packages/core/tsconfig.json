{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    // Core is built against D1 now, so `D1Database` has to be in scope. `bun`
    // stays because config/user.ts is still node-shaped — it leaves when the
    // CLI does.
    "types": ["bun", "@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "workers-test/**/*.ts", "vitest.config.ts"]
}
